# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cognieos
# Required in production. Use long random values.
JWT_SECRET=mobile
ENCRYPTION_KEY=            # encrypts provider credentials stored per organization
URL_SIGNING_SECRET=        # signs short-lived recording URLs
# Public HTTPS URL that telephony/messaging providers can reach (webhooks).
PUBLIC_BASE_URL=https://boogieman-unicorn-charred.ngrok-free.dev
CORS_ORIGIN=http://localhost:5173
JOBS_ENABLED=true

# ---------------------------------------------------------------- telephony (optional)
# Credentials can also be stored per organization (encrypted) in Settings → Integrations.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For the browser softphone (Twilio Voice SDK): API key + TwiML App whose Voice URL is
# {PUBLIC_BASE_URL}/api/v1/webhooks/telephony/twilio?evt=client
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_TOKEN=      # random secret appended to Exotel callback URLs (Exotel does not sign webhooks)

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ---------------------------------------------------------------- messaging (optional)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- AI (optional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------- push (FCM, optional)
# Firebase service account (Project settings > Service accounts > Generate key) for Android push.
# Either a file path or the inline JSON.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT=
