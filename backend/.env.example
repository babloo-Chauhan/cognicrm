# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cognieos
# Required in production. Use long random values.
JWT_SECRET=               # long random value (openssl rand -hex 32)
ENCRYPTION_KEY=            # encrypts provider credentials stored per organization
URL_SIGNING_SECRET=        # signs short-lived recording URLs
# Public HTTPS URL that telephony/messaging providers can reach (webhooks).
PUBLIC_BASE_URL=https://boogieman-unicorn-charred.ngrok-free.dev
CORS_ORIGIN=http://localhost:5173   # comma-separated web origins allowed to call the API
FRONTEND_URL=http://localhost:5173  # used for payment return URLs
JOBS_ENABLED=true

# ---------------------------------------------------------------- telephony (optional)
# Credentials can also be stored per organization (encrypted) in Settings → Integrations.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For the browser softphone (Twilio Voice SDK): API key + TwiML App whose Voice URL is
# {PUBLIC_BASE_URL}/api/v1/webhooks/telephony/twilio?evt=client
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_TOKEN=      # random secret appended to Exotel callback URLs (Exotel does not sign webhooks)

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ---------------------------------------------------------------- messaging (optional)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- AI (optional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------- push (FCM, optional)
# Firebase service account (Project settings > Service accounts > Generate key) for Android push.
# Either a file path or the inline JSON.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- SaaS platform
# Separate signing secret for super-admin tokens (defaults to one derived from JWT_SECRET)
PLATFORM_JWT_SECRET=
# First super admin, created on startup when none exists (password 12+ chars).
# Or: npm run create-super-admin -- <email> <password>
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner
# DNS servers Node uses for mongodb+srv lookups ("system" = OS resolver)
DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------- payments (optional; checkout shows NOT_CONFIGURED without them)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # webhook URL: {PUBLIC_BASE_URL}/api/v1/webhooks/payments/razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=     # webhook URL: {PUBLIC_BASE_URL}/api/v1/webhooks/payments/stripe
